# Supabase CMS — העתיקו לקובץ .env (ו-Vercel Environment Variables)
# הערכים נמצאים ב: Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps Embed API — מפת הנכס בעמוד הפרויקט (סקשן "מפה")
# הפעילו "Maps Embed API" בפרויקט Google Cloud, צרו מפתח, והגבילו אותו
# ל-HTTP referrers (הדומיין שלכם + localhost). חינמי, ללא מגבלת שימוש.
VITE_GOOGLE_MAPS_KEY=your-google-maps-embed-api-key

# Cloudinary — העלאת סרטוני וידאו (מומלץ לקבצים כבדים). אם לא מוגדר — קבצים
# עולים לאחסון של Supabase במקום. צרו ב-Cloudinary "Unsigned upload preset".
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Green API — התראת וואטסאפ על כל ליד חדש (server/_whatsapp.js).
# הערכים נמצאים בקונסולה של Green API. אלה סודות: הם נכנסים אך ורק
# ל-Vercel → Settings → Environment Variables, לעולם לא לקוד (המאגר ציבורי).
# בלי שניהם ההתראה פשוט לא נשלחת, והמייל ממשיך לצאת כרגיל.
GREENAPI_ID_INSTANCE=your-instance-id
GREENAPI_TOKEN=your-instance-token
# אופציונלי — כתובת ה-API (apiUrl) מהקונסולה, אם היא שונה מברירת המחדל
GREENAPI_BASE=
# אופציונלי — מספרים לקבלת ההתראה, מופרדים בפסיק. ריק = ברירת המחדל שבקוד
WHATSAPP_NOTIFY_TO=
