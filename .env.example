# Supabase CMS — העתיקו לקובץ .env (ו-Vercel Environment Variables)
# הערכים נמצאים ב: Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps Embed API — מפת הנכס בעמוד הפרויקט (סקשן "מפה")
# הפעילו "Maps Embed API" בפרויקט Google Cloud, צרו מפתח, והגבילו אותו
# ל-HTTP referrers (הדומיין שלכם + localhost). חינמי, ללא מגבלת שימוש.
VITE_GOOGLE_MAPS_KEY=your-google-maps-embed-api-key

# Cloudinary — העלאת סרטוני וידאו (מומלץ לקבצים כבדים). אם לא מוגדר — קבצים
# עולים לאחסון של Supabase במקום. צרו ב-Cloudinary "Unsigned upload preset".
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Green API — התראת וואטסאפ על כל ליד חדש (server/_whatsapp.js).
# הערכים נמצאים בקונסולה של Green API. אלה סודות: הם נכנסים אך ורק
# ל-Vercel → Settings → Environment Variables, לעולם לא לקוד (המאגר ציבורי).
# בלי שניהם ההתראה פשוט לא נשלחת, והמייל ממשיך לצאת כרגיל.
GREENAPI_ID_INSTANCE=your-instance-id
GREENAPI_TOKEN=your-instance-token
# אופציונלי — כתובת ה-API (apiUrl) מהקונסולה, אם היא שונה מברירת המחדל
GREENAPI_BASE=
# אופציונלי — מספרים לקבלת ההתראה, מופרדים בפסיק. ריק = ברירת המחדל שבקוד
WHATSAPP_NOTIFY_TO=

# ============================================================
# Every other variable the code reads. Names only: the values are secrets and live in
# Vercel > Settings > Environment Variables, never in the repository. A variable left empty
# switches its feature off; nothing breaks. Finance variables are explained in docs/finance/README.md.
# ============================================================

# --- site, browser side (optional) ---
VITE_GA_MEASUREMENT_ID=
VITE_CONTENT_ENGINE_URL=

# --- Supabase, server side ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- general ---
SITE_URL=
CRON_SECRET=

# --- email (Resend) ---
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_ALWAYS_TO=
FINANCE_FROM=

# --- AI ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_QUICK=
CLAUDE_MODEL_DEFAULT=
CLAUDE_MODEL_COMPLEX=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_ENGINE_IMAGE_MODEL=
OPENAI_VIDEO_MODEL=
TTS_MODEL=
TRANSCRIBE_MODEL=
VIDEO_PROVIDER=
VEO_MODEL=
# one of the two (same key)
GEMINI_API_KEY=
GOOGLE_AI_KEY=

# --- Google Analytics for the admin dashboard (service account) ---
GA4_PROPERTY_ID=
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=

# --- Metricool (content engine) ---
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# an older name, read only by the status check
METRICOOL_TOKEN=

# --- finance: mail and cloud connections (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- finance: secrets and switches ---
FINANCE_STATE_SECRET=
FINANCE_TICK_SECRET=
FINANCE_MORNING_AUTH=
FINANCE_SSO_PROVIDERS=
FINANCE_RATE_LIMIT=
FINANCE_SCAN_ON_CONNECT=
FINANCE_NIGHT_CHECK=
FINANCE_QUICK_COLLECT=
FINANCE_TAX_WATCH=
FINANCE_ALLOW_PRIVATE_WEBHOOKS=

# --- finance: reading models and cost ---
FINANCE_TIERED=
FINANCE_EFFORT=
FINANCE_MODEL=
FINANCE_MODEL_FIRST=
FINANCE_MODEL_EXTRACT=
FINANCE_MODEL_VERIFY=
FINANCE_TRIAGE_MODEL=

# --- finance: WhatsApp scanners ---
FINANCE_WHATSAPP_WEBHOOK_TOKEN=
# The WhatsApp welcome to a new site lead, sent by the Afik Hanahal site from the office number (server/_lead-welcome.js).
# Uses FINANCE_WHATSAPP_WEBHOOK_TOKEN above. Optional: AFIK_LEAD_WELCOME_URL (default https://www.afikhanahal.co.il/api/meta/kurkoos-lead), LEAD_WELCOME=off to stop it.
AFIK_LEAD_WELCOME_URL=
LEAD_WELCOME=
FINANCE_WHATSAPP_NUMBER=
FINANCE_WHATSAPP_VIA_URL=
FINANCE_WHATSAPP_FORWARD_URL=
FINANCE_WHATSAPP_FORWARD_TOKEN=
FINANCE_WA_MEDIA_HOSTS=

# --- finance: Google Drive archive ---
FINANCE_DRIVE_SCOPE=
FINANCE_DRIVE_WATCH=
FINANCE_DRIVE_RESUMABLE_FROM=

# --- tests only: base addresses that point the server at the local fakes (scripts/finance-e2e). Never set in production. ---
# FINANCE_ANTHROPIC_API FINANCE_RESEND_API FINANCE_GMAIL_API FINANCE_GRAPH_API FINANCE_DRIVE_API FINANCE_DRIVE_UPLOAD
