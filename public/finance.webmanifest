{
  "name": "KURKOOS FINANCE",
  "short_name": "Kurkoos Finance",
  "description": "מערכת הכספים של קבוצת קורקוס: חשבוניות, קבלות, מע״מ ודוחות הנהלה.",
  "lang": "he",
  "dir": "rtl",
  "start_url": "/admin/finance",
  "scope": "/admin/finance",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f7f5",
  "theme_color": "#07293a",
  "icons": [
    {
      "src": "/finance/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/finance/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/finance/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/admin/finance",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "צילום קבלה",
      "url": "/admin/finance?capture=1"
    },
    {
      "name": "קבלות וחשבוניות",
      "url": "/admin/finance/receipts"
    },
    {
      "name": "ממתינים לבדיקה",
      "url": "/admin/finance/pending"
    }
  ]
}
