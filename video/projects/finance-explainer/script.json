 "lines": [
  {
   "id": "v01",
   "text": "קורקוס פיננס. כל ההוצאות של הקבוצה, במקום אחד."
  },
  {
   "id": "v02",
   "text": "חשבוניות מגיעות מהמייל, מהוואטסאפ, ומצילום בטלפון."
  },
  {
   "id": "v03",
   "text": "קל לאבד אחת בדרך. כאן, כולן נאספות למקום אחד."
  },
  {
   "id": "v04",
   "text": "המערכת סורקת את המייל ואת הוואטסאפ,"
  },
  {
   "id": "v05",
   "text": "קוראת מכל מסמך ספק, סכום, מע״מ ותאריך,"
  },
  {
   "id": "v06",
   "text": "ומראה במבט אחד מה מחכה לטיפול."
  },
  {
   "id": "v07",
   "text": "כל המסמכים מרוכזים ברשימה אחת."
  },
  {
   "id": "v08",
   "text": "מה שלא ברור, מחכה לבדיקה,"
  },
  {
   "id": "v09",
   "text": "ומסמך שאושר, נכנס לדוחות."
  },
  {
   "id": "v10",
   "text": "המנכ״ל רואה את הוצאות החודש של כל הקבוצה,"
  },
  {
   "id": "v11",
   "text": "כל חברה בנפרד, בלחיצה אחת,"
  },
  {
   "id": "v12",
   "text": "והשוואה לחודשים קודמים."
  },
  {
   "id": "v13",
   "text": "בסוף התקופה, בוחרים תקופה וחברה,"
  },
  {
   "id": "v14",
   "text": "מפיקים דוח אקסל עם הקבצים המקוריים,"
  },
  {
   "id": "v15",
   "text": "ושולחים לרואה החשבון בלחיצה אחת."
  },
  {
   "id": "v16",
   "text": "הכול נשמר בארכיון בגוגל דרייב,"
  },
  {
   "id": "v17",
   "text": "בתיקייה מסודרת לכל חברה,"
  },
  {
   "id": "v18",
   "text": "וזמין גם מהטלפון."
  },
  {
   "id": "v19",
   "text": "פחות ניירת, יותר שליטה."
  }
 ],
