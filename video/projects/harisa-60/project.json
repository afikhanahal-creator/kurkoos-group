{
 "name": "הריסה ובנייה מחדש: מהבית הישן לבית החדש (דקה)",
 "duration": 49.65,
 "vo_tempo": 1.1,
 "music": {
  "bpm": 112,
  "style": "cinematic",
  "quiet": true,
  "drums": true,
  "drums_from": 18.0
 },
 "mix": {
  "duck": "steady"
 },
 "lines": [
  {
   "id": "v01",
   "vo": "v01",
   "start": 0.2,
   "end": 5.225,
   "text": "בית ישן, על מגרש טוב. לשפץ אותו, או להרוס ולבנות מחדש?"
  },
  {
   "id": "v02",
   "vo": "v02",
   "start": 5.365,
   "end": 11.59,
   "text": "לפני שמחליטים, בודקים. את מצב השלד, את הקרקע, ואת זכויות הבנייה במגרש."
  },
  {
   "id": "v03",
   "vo": "v03",
   "start": 11.73,
   "end": 16.864,
   "text": "מתכננים את הבית החדש, ומגישים להיתר. בלי היתר ביד, לא מתחילים."
  },
  {
   "id": "v04",
   "vo": "v04",
   "start": 17.004,
   "end": 22.865,
   "text": "מגדרים את האתר, מנתקים תשתיות, ורק אז הריסה מבוקרת, עם בטיחות מלאה."
  },
  {
   "id": "v05",
   "vo": "v05",
   "start": 23.005,
   "end": 26.612,
   "text": "המגרש מתפנה, ומסמנים בשטח את קווי הבית החדש."
  },
  {
   "id": "v06",
   "vo": "v06",
   "start": 26.752,
   "end": 31.959,
   "text": "כלונסאות, יסודות ושלד. כל שלב נבדק, לפני שיוצקים."
  },
  {
   "id": "v07",
   "vo": "v07",
   "start": 32.099,
   "end": 37.051,
   "text": "מערכות, איטום וגמר. עם פיקוח צמוד, עד המסירה."
  },
  {
   "id": "v08",
   "vo": "v08",
   "start": 37.191,
   "end": 42.216,
   "text": "ובסוף, בית חדש. בנוי לפי מה שתכננתם, מהיסוד."
  },
  {
   "id": "v09",
   "vo": "v09",
   "start": 42.356,
   "end": 47.854,
   "text": "קבוצת קורקוס. מקרקע ועד מסירת מפתח. דברו איתנו, לפני שמחליטים."
  }
 ],
