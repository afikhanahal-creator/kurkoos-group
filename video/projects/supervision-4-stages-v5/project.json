 },
 "lines": [
  {
   "id": "v01",
   "vo": "v01",
   "start": 0.15,
   "end": 3.55,
   "text": "כל וילה שאנחנו מוסרים, מתחילה כאן. בקרקע."
  },
  {
   "id": "v02",
   "vo": "v02",
   "start": 3.67,
   "end": 8.569,
   "text": "יסודות וכלונסאות, עמוק באדמה. הם מחזיקים את כל הבית."
  },
  {
   "id": "v03",
   "vo": "v03",
   "start": 8.689,
   "end": 15.124,
   "text": "קירות בטון, תבניות וברזל. כל שלב נבדק, לפני שממשיכים הלאה."
  },
  {
   "id": "v04",
   "vo": "v04",
   "start": 15.244,
   "end": 20.18,
   "text": "ברזל לתקרה, לפני היציקה. הרגע שבו אין מקום לטעויות."
  },
  {
   "id": "v05",
   "vo": "v05",
   "start": 20.3,
   "end": 26.878,
   "text": "ולאורך כל הדרך, אנחנו מלווים אתכם. מהתכנון, דרך השלד והגמר, ועד המפתח."
  },
  {
   "id": "v06",
   "vo": "v06",
   "start": 26.998,
   "end": 29.29,
   "text": "וזה הרגע, שבשבילו בונים."
  },
  {
   "id": "v07",
   "vo": "v07",
   "start": 29.41,
   "end": 33.524,
   "text": "קבוצת קורקוס. מקרקע ועד מסירת מפתח."
  },
  {
   "id": "v08",
   "vo": "v08",
   "start": 33.644,
   "end": 38.686,
   "text": "בונים וילה? השאירו פרטים, ונציג שלנו יחזור אליכם לשיחת ייעוץ."
  }
 ],
