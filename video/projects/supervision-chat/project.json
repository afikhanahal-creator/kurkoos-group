 "lines": [
  {"start": 0.15, "end": 1.45, "text": "פיקוח בנייה, קבוצת קורקוס."},
  {"start": 2.00, "end": 6.70, "text": "בית פרטי לא נבנה רק מתוכניות. הוא נבנה מאלפי החלטות קטנות."},
  {"start": 7.30, "end": 13.70, "text": "בודקים את הביצוע, מתעדים את מה שצריך לתקן ומוודאים שכל שלב מתקדם לפי התכנון והדרישות."},
  {"start": 14.30, "end": 19.40, "text": "לפני שלבים שאי אפשר להחזיר לאחור, עוצרים לבדוק."},
  {"start": 20.20, "end": 25.70, "text": "גם התשלומים צריכים לשקף את מה שבוצע בפועל, בהתאם להסכם ולשלבי הפרויקט."},
  {"start": 26.20, "end": 32.10, "text": "כי המטרה היא לא רק לסיים לבנות. המטרה היא להגיע לבית שאתם יכולים להיות גאים בו."},
  {"start": 32.70, "end": 35.20, "text": "מתכננים לבנות בית? התחילו בפיקוח נכון."},
  {"start": 36.20, "end": 39.40, "text": "כתבו 'מדריך' בתגובות לקבלת המדריך המלא."}
 ],
